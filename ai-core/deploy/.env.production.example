# Copy to deploy/.env.production and set real values there. Never commit that file.
APP_NAME="NEXORA QR"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://qr.example.com
APP_DOMAIN=qr.example.com
APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# These four values must match the DB_* values injected by Compose.
MYSQL_DATABASE=nexora_qr
MYSQL_USER=nexora_qr
MYSQL_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public

MAIL_MAILER=log
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_API_VERSION=
WHATSAPP_ORDER_TEMPLATE_NAME=
WHATSAPP_ORDER_TEMPLATE_LANGUAGE=ar
OPENAI_API_KEY=
OPENAI_MENU_SCAN_MODEL=gpt-5.5
OPENAI_BASE_URL=https://api.openai.com/v1
